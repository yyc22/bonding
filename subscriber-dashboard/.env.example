# Copy this file to .env and fill in your own values.

PORT=3000

# YouTube Data API v3 key. Create one at https://console.cloud.google.com/
# (APIs & Services -> Credentials -> Create API key), after enabling the
# "YouTube Data API v3" for your project. Public channel stats only, no
# OAuth required.
YOUTUBE_API_KEY=

# TikTok for Developers app credentials. Register an app at
# https://developers.tiktok.com/apps, add the "Login Kit" product with the
# user.info.basic and user.info.stats scopes, and set this exact redirect
# URI in the app's settings.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Comma-separated YouTube @handles to auto-add on startup, so you don't have
# to add them by hand in the dashboard every time you set this up fresh.
# TikTok has no equivalent — it only ever tracks whichever account you
# authorize via "Connect TikTok", so there's nothing to pre-fill there.
SEED_YOUTUBE_HANDLES=@yeahyoucantoo

# How often (in hours) to poll connected channels for fresh stats.
POLL_INTERVAL_HOURS=6

# Where the SQLite database file is stored.
DB_PATH=./data/subscriber-dashboard.db
